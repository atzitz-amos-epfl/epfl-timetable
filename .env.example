# Account sync (optional). Copy this file to ".env" and fill in your Supabase project's values:
# Supabase dashboard > Project Settings > API (or "Connect"). Rebuild afterwards (npm run build).
# The anon / publishable key is meant to be public: row-level security (supabase/schema.sql) protects the data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
